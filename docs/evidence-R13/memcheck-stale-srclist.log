## بعد الإصلاح: القائمة تُشتق من البناء نفسه
make-x64/Makefile: هدف print-srcs جديد:
	print-srcs:
		@printf '%s\n' '$(patsubst %.o,%.c,$(notdir $(OBJECTS)))'
memcheck.sh:102-105:
	srcs=$(make -s print-srcs)

